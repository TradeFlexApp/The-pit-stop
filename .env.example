# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).

# ---------- Supabase (Dashboard → Project Settings → API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Safe for the browser. New projects issue sb_publishable_... keys
# (the legacy "anon" JWT also works until end of 2026).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser or commit it.
# (the legacy "service_role" JWT also works until end of 2026).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------- Google Gemini, free tier (https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=your_gemini_api_key
# Optional. Default is gemini-3.5-flash-lite (free, fastest). gemini-3.8-flash is
# also free and smarter, but slower. Limits are per project; see AI Studio → Rate limits.
# GEMINI_MODEL=gemini-3.8-flash

# ---------- Admin (/admin) ----------
# Comma-separated emails allowed to sign in to the admin. Create the users in
# Supabase → Authentication → Users ("Add user", auto-confirm). Alternatively add
# rows to public.admin_users (see README).
ADMIN_EMAILS=owner@example.com

# ---------- Site ----------
# Public URL of the site, used for social previews and the sitemap (Vercel sets this automatically in production).
# NEXT_PUBLIC_SITE_URL=https://thepitstop.ca
