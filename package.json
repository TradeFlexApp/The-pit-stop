{
  "name": "the-pit-stop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "supabase db query --linked --file supabase/seed.sql",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
