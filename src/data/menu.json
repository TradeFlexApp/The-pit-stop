  "faqs": [
    {
      "q": "Where exactly is The Pit Stop?",
      "a": "530 MacKenzie Blvd in Fort McMurray, across from the Oil Sands Discovery Centre. Park out front and follow the smell of the griddle."
    },
    {
      "q": "What does 1500, 2500 and 3500 mean?",
      "a": "Engine size. A 1500 is a single smashed patty, a 2500 is a double, and a 3500 is a triple. Every burger comes in all three."
    },
    {
      "q": "Do you serve breakfast?",
      "a": "Yes. Breakfast sandwiches and coffee are on from open until 11 AM, Monday to Saturday. The regular menu runs all day."
    },
    {
      "q": "Can I order ahead or get delivery?",
      "a": "Call ahead for pickup any time we're open. SkipTheDishes and DoorDash are coming soon; the links will light up at the bottom of this page the day they go live."
    },
    {
      "q": "Feeding a whole crew?",
      "a": "We do group and office orders. Call the day before for anything over ten burgers and we'll have it hot and boxed when you pull in."
    },
    {
      "q": "What about allergies?",
      "a": "Allergens are listed on every menu item. Our kitchen shares equipment, so please tell us about any allergy when you order."
    }
  ],
  "value_props": [
    {
      "title": "Smashed to order",
      "body": "Fresh Alberta beef hits the griddle when you order it, never before. Crispy edges, juicy centre."
    },
    {
      "title": "Breakfast till 11",
      "body": "Egg sandwiches and hot coffee for the early shift, then burgers the rest of the day."
    },
    {
      "title": "In and out fast",
      "body": "A pit stop is supposed to be quick. Call ahead and your order is boxed when you pull in."
    }
